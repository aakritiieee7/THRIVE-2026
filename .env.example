# THRIVE environment configuration — copy to .env and adjust.

# --- Backend (FastAPI) -----------------------------------------------------
# Defaults to sqlite (./backend/thrive.db) when unset; use Postgres for
# the full docker-compose stack or production.
#DATABASE_URL=postgresql://thrive:thrive@postgres:5432/thrive

# JWT signing secret. MUST be set for any shared/deployed environment.
THRIVE_SECRET=replace-with-a-long-random-string

# Optional LLM provider for the assistant (OpenAI-compatible chat API).
# When unset, the assistant uses its deterministic local grounded fallback.
#LLM_API_KEY=
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# Connect a real WhatsApp Business number. Without these the webhook still
# works and replies are generated, but nothing is sent to a real phone
# (see /api/assistant/whatsapp/status → mode: "simulation").
#
# Where to get each (Meta Business Manager → API Setup / System Users):
#   WHATSAPP_TOKEN       — a *permanent* System User token with the
#       whatsapp_business_manage_phone_number + ..._messaging permissions,
#       or a short-lived token for testing. Paste the token value only.
#   WHATSAPP_PHONE_ID    — the phone-number id shown on the Display Page
#       (a long numeric id, NOT the phone number itself).
#   WHATSAPP_VERIFY_TOKEN — any random string YOU pick; enter the same value
#       as "Verify token" when Meta checks the webhook URL.
#   WHATSAPP_APP_SECRET  — your App Secret (Settings → Basic). Required for
#       webhook signature checking before go-live.
#   WHATSAPP_DISPLAY_NUMBER — the human-readable number the UI shows to
#       teachers (e.g. +91 98765 43210). Cosmetic.
#
# Webhook URL to register in Meta:  https://<backend-host>/assistant/whatsapp
#   NOTE: no /api prefix — Meta calls the FastAPI backend directly. The Next
#   /api/* proxy is only for the browser.
#   Full walkthrough: docs/WHATSAPP_SETUP.md
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_ID=
#WHATSAPP_VERIFY_TOKEN=thrive-verify
#WHATSAPP_APP_SECRET=
#WHATSAPP_DISPLAY_NUMBER=

# --- Frontend (Next.js) ----------------------------------------------------
# REQUIRED. Backend origin for the /api/* proxy (server-side).
# Every browser call goes /api/* -> this URL. Left unset it falls back to
# localhost:8000, which on Vercel/Supabase/any serverless host does not exist:
# every request 502s and the assistant reports
# "Could not start a guest session right now".
#
#   local:   http://127.0.0.1:8000   (use 127.0.0.1 — Node 18+ resolves
#                                     "localhost" to ::1, where uvicorn is not)
#   hosted:  https://your-backend-host   (e.g. https://thrive-2026-api.fly.dev)
#
# On Vercel this must be set in Project → Settings → Environment Variables,
# then redeploy. It is read at request time by pages/api/[...proxy].ts.
BACKEND_URL=http://127.0.0.1:8000
